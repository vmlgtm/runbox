{
  "name": "runbox",
  "version": "0.1.0",
  "description": "Framework-agnostic downstream verification harness for AI coding agents",
  "type": "module",
  "bin": {
    "runbox": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^13.1.0",
    "fast-check": "^3.23.2",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
